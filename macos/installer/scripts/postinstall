#!/bin/bash
#
# Roda como root, depois que o instalador copiou os arquivos.
#
# Faz o que a cópia de arquivos não consegue: cria o diretório de estado, gera a
# identidade TLS na máquina do usuário e sobe o daemon. É o mesmo trabalho do
# scripts/install.sh — e é de propósito que a identidade nasça aqui, e não venha
# no pacote: uma chave privada embarcada no instalador seria a mesma chave em
# toda instalação do mundo, o que anularia o pinning inteiro.

set -euo pipefail

STATE_DIR="/Library/Application Support/PhoneAuth"
LABEL="dev.phoneauth.daemon"
PLIST="/Library/LaunchDaemons/$LABEL.plist"

install -d -o root -g wheel -m 0700 "$STATE_DIR"

if [[ -f "$STATE_DIR/identity.p12" ]]; then
    echo "identidade TLS já existe; preservando"
else
    echo "gerando identidade TLS P-256"
    PASSPHRASE="$(openssl rand -base64 32)"
    TMP="$(mktemp -d)"
    trap 'rm -rf "$TMP"' EXIT

    # Auto-assinado de propósito: o celular fixa o hash do SPKI no pareamento,
    # então não há CA nem cadeia a validar. A confiança vem do que foi visto no
    # QR e de nada mais.
    openssl ecparam -name prime256v1 -genkey -noout -out "$TMP/key.pem" 2>/dev/null
    openssl req -new -x509 -key "$TMP/key.pem" -out "$TMP/cert.pem" \
        -days 3650 -sha256 \
        -subj "/CN=phoneauthd/O=PhoneAuth" \
        -addext "subjectAltName=DNS:$(hostname -s).local,DNS:localhost" 2>/dev/null

    openssl pkcs12 -export -out "$TMP/identity.p12" \
        -inkey "$TMP/key.pem" -in "$TMP/cert.pem" \
        -passout "pass:$PASSPHRASE" 2>/dev/null

    install -o root -g wheel -m 0600 "$TMP/identity.p12" "$STATE_DIR/identity.p12"
    printf '%s' "$PASSPHRASE" > "$TMP/identity.pass"
    install -o root -g wheel -m 0600 "$TMP/identity.pass" "$STATE_DIR/identity.pass"

    rm -rf "$TMP"
    trap - EXIT
fi

# `bootout` antes para o caso de atualização sobre uma instalação viva. O `||
# true` cobre a primeira instalação, em que não há nada para derrubar.
launchctl bootout "system/$LABEL" 2>/dev/null || true

# `bootout` retorna antes de o serviço ter sumido de fato. Fazer `bootstrap`
# em seguida, sem esperar, rende "Operation already in progress" (erro 37) —
# e como o postinstall sai com 1, o instalador inteiro reporta falha. Numa
# instalação limpa isso nunca acontece, porque não há nada para derrubar; só
# aparece ao atualizar sobre um daemon vivo, que é o caminho comum depois da
# primeira release.
for _ in $(seq 1 50); do
    launchctl print "system/$LABEL" >/dev/null 2>&1 || break
    sleep 0.2
done

# Mesmo esperando, a corrida não é só nossa: o launchd tem trabalho pendente
# que não dá para observar. Uma tentativa única aqui transforma um atraso de
# meio segundo em instalação falhada, então insiste antes de desistir.
tentativa=1
until saida="$(launchctl bootstrap system "$PLIST" 2>&1)"; do
    if [[ $tentativa -ge 5 ]]; then
        echo "erro: launchctl bootstrap falhou para $LABEL após $tentativa tentativas" >&2
        echo "      launchctl disse: ${saida:-(nada)}" >&2
        exit 1
    fi
    tentativa=$((tentativa + 1))
    sleep 1
done

exit 0
